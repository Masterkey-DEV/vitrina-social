# Base de datos (Neon/Postgres serverless). Ejemplo Neon:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL=""

# Secreto para firmar los JWT (genera uno largo y aleatorio)
JWT_SECRET=""

# Cloudinary (almacenamiento de imágenes)
CLOUDINARY_NAME=""
CLOUDINARY_KEY=""
CLOUDINARY_SECRET=""

# URL pública de la app (opcional; se usa para fetches del servidor)
# En Vercel se resuelve automáticamente con VERCEL_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
